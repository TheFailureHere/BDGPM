function AddSli(p, n, vK, mn, mx)
    local box = Instance.new("TextBox", p)
    box.Size = UDim2.new(0.92, 0, 0, 28)
    box.BackgroundColor3 = Color3.fromRGB(16, 16, 16)
    box.Text = n .. ": " .. tostring(Vals[vK])
    box.TextColor3 = Color3.new(0.8, 0.8, 0.8)
    box.Font = "Code"
    box.TextSize = 12
    box.ClearTextOnFocus = false
    Instance.new("UICorner", box)

    local function ApplyValue()
        local rawNum = box.Text:match(":%s*(%-?%d+%.?%d*)") or box.Text:match("(%-?%d+%.?%d*)")
        local v = tonumber(rawNum)
        if v then
            if mn and mx then
                Vals[vK] = math.clamp(v, mn, mx)
            else
                Vals[vK] = v
            end
        end
    end

    box:GetPropertyChangedSignal("Text"):Connect(ApplyValue)
    box.FocusLost:Connect(function()
        ApplyValue()
        box.Text = n .. ": " .. tostring(Vals[vK])
    end)

    table.insert(UIUpdaters, function() box.Text = n .. ": " .. tostring(Vals[vK]) end)
    return box
end

