        if Vals.AimbotLogic=="Hold" then AimHold=true else FLAGS.Aimbot=not FLAGS.Aimbot end
        for _,fn in pairs(UIUpdaters) do pcall(fn) end
    end
    if KeyMatches(i,BINDS.Triggerbot) then
        if Vals.TriggerbotLogic=="Hold" then TriggerHold=true else FLAGS.Triggerbot=not FLAGS.Triggerbot end
        for _,fn in pairs(UIUpdaters) do pcall(fn) end
    end
    if g then return end
    if KeyMatches(i,BINDS.Switch) then
        Vals.TPart=Vals.TPart=="Head" and "Torso" or "Head"
        for _,fn in pairs(UIUpdaters) do pcall(fn) end
    end
    local function HL(bind,flag,logicKey)
        if not KeyMatches(i,bind) then return end
        if Vals[logicKey]=="Hold" then FLAGS[flag]=true else FLAGS[flag]=not FLAGS[flag] end
        for _,fn in pairs(UIUpdaters) do pcall(fn) end
