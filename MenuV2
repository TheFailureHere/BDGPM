local PuppetStorage = Instance.new("Folder")
PuppetStorage.Name = "PuppetStorage"; PuppetStorage.Parent = Screen

local PuppetCache = {}
local activePuppet = nil
local currentVPTarget = nil

local function GetOrCreatePuppet(entityModel)
    if not entityModel or not entityModel:IsA("Model") then return nil end
    if PuppetCache[entityModel] then return PuppetCache[entityModel] end

    entityModel.Archivable = true
    for _, desc in ipairs(entityModel:GetDescendants()) do desc.Archivable = true end

    local clone = entityModel:Clone()
    if not clone then return nil end

    local partMap = {}
    for _, clonePart in ipairs(clone:GetDescendants()) do
        if clonePart:IsA("Script") or clonePart:IsA("LocalScript") or clonePart:IsA("Sound") or clonePart:IsA("AudioPlayer") then
            clonePart:Destroy()
        elseif clonePart:IsA("BasePart") then
            clonePart.Anchored = true
            clonePart.CanCollide = false
            
            local origPart
            if clonePart.Parent == clone then
                origPart = entityModel:FindFirstChild(clonePart.Name)
            elseif clonePart.Parent and clonePart.Parent.Parent == clone then
                local parentObj = entityModel:FindFirstChild(clonePart.Parent.Name)
                if parentObj then origPart = parentObj:FindFirstChild(clonePart.Name) end
            end
            if not origPart then origPart = entityModel:FindFirstChild(clonePart.Name, true) end

            if origPart and origPart:IsA("BasePart") then
                partMap[clonePart] = origPart
            end
        end
    end

    clone:PivotTo(CFrame.new(0, 0, 0))
    clone.Parent = PuppetStorage

    local puppetData = { Model = clone, PartMap = partMap }
    PuppetCache[entityModel] = puppetData

    entityModel.AncestryChanged:Connect(function(_, parent)
        if not parent then
            if activePuppet == puppetData then activePuppet = nil; currentVPTarget = nil end
            clone:Destroy()
            PuppetCache[entityModel] = nil
        end
    end)

    return puppetData
end

local function UpdateTargetViewport(targetModel)
    if currentVPTarget ~= targetModel then
        currentVPTarget = targetModel
        if activePuppet and activePuppet.Model then
            activePuppet.Model.Parent = PuppetStorage
            activePuppet = nil
        end
        if not targetModel then return end

        local data = GetOrCreatePuppet(targetModel)
        if data and data.Model then
            activePuppet = data
            activePuppet.Model.Parent = TargetViewport
        end
    end

    if targetModel and activePuppet and activePuppet.Model and activePuppet.Model.Parent == TargetViewport then
        local camDist = tonumber(Vals.HUDCamDist) or 2.0
        local camY    = tonumber(Vals.HUDCamY) or 1.5
        local fovVal  = tonumber(Vals.HUDCamFOV) or 25

        VPCam.FieldOfView = math.clamp(fovVal, 1, 120)
        VPCam.CFrame = CFrame.lookAt(Vector3.new(0, camY, -camDist), Vector3.new(0, camY - 0.1, 0))

        local rootCF = targetModel:GetPivot()
        for clonePart, origPart in pairs(activePuppet.PartMap) do
            if clonePart.Parent and origPart.Parent then
                local relCF = rootCF:ToObjectSpace(origPart.CFrame)
                clonePart.CFrame = CFrame.new(0, 0, 0) * relCF
            end
        end
    end
end

