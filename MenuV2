local function DLine(cache,key,idx)
    if not cache[key] then cache[key]={} end
    if not cache[key][idx] then
        local ln=Drawing.new("Line"); ln.Visible=false; cache[key][idx]=ln
    end
    return cache[key][idx]
end

local function GetSkeletonLines(p,n)
    if not Cache.Skeletons[p] then Cache.Skeletons[p]={} end
    local s=Cache.Skeletons[p]
    while #s<n do local ln=Drawing.new("Line"); ln.Visible=false; s[#s+1]=ln end
    return s
end

local function SetCornerBox(p,x,y,w,h,col,thick)
    local cl=Vals.BoxCornerLen
    local segs={{x,y,x+cl,y},{x,y,x,y+cl},{x+w,y,x+w-cl,y},{x+w,y,x+w,y+cl},
                {x,y+h,x+cl,y+h},{x,y+h,x,y+h-cl},{x+w,y+h,x+w-cl,y+h},{x+w,y+h,x+w,y+h-cl}}
    for i=1,8 do
        local ln=DLine(Cache.Squares,p,i); local s=segs[i]
        ln.From=Vector2.new(s[1],s[2]); ln.To=Vector2.new(s[3],s[4])
        ln.Color=col; ln.Thickness=thick; ln.Visible=true
    end
end

local function SetFullBox(p,x,y,w,h,col,thick)
    local segs={{x,y,x+w,y},{x,y,x,y+h},{x+w,y,x+w,y+h},{x,y+h,x+w,y+h}}
    for i=1,4 do
        local ln=DLine(Cache.Squares,p,i); local s=segs[i]
        ln.From=Vector2.new(s[1],s[2]); ln.To=Vector2.new(s[3],s[4])
        ln.Color=col; ln.Thickness=thick; ln.Visible=true
    end
    for i=5,8 do local ln=DLine(Cache.Squares,p,i); ln.Visible=false end
end

local function HideBox(p)
    if not Cache.Squares[p] then return end
    for _,ln in pairs(Cache.Squares[p]) do if ln then ln.Visible=false end end
end

local function GetProjectedBounds(char)
    local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then return nil end
    local cf=hrp.CFrame; local sz=Vector3.new(4,5.5,3)
    local hx,hy,hz=sz.X*0.5,sz.Y*0.5,sz.Z*0.5
    local pts={
        cf*CFrame.new(-hx, hy,-hz), cf*CFrame.new( hx, hy,-hz),
        cf*CFrame.new(-hx,-hy,-hz), cf*CFrame.new( hx,-hy,-hz),
        cf*CFrame.new(-hx, hy, hz), cf*CFrame.new( hx, hy, hz),
        cf*CFrame.new(-hx,-hy, hz), cf*CFrame.new( hx,-hy, hz),
    }
    local mnX,mnY,mxX,mxY = math.huge,math.huge,-math.huge,-math.huge
    local any=false
    for _,c in ipairs(pts) do
        local pr,on=Cam:WorldToViewportPoint(c.Position)
        if on then any=true end
        mnX=math.min(mnX,pr.X); mnY=math.min(mnY,pr.Y)
        mxX=math.max(mxX,pr.X); mxY=math.max(mxY,pr.Y)
    end
    if not any then return nil end
    return mnX,mnY,mxX-mnX,mxY-mnY
end

