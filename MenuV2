local function ReleasePlayer(p)
    if Cache.Indicators[p]  then Cache.Indicators[p]:Destroy();  Cache.Indicators[p]=nil  end
    if Cache.Beams[p]       then pcall(function() Cache.Beams[p]:Remove() end); Cache.Beams[p]=nil end
    if Cache.Labels[p]      then Cache.Labels[p]:Destroy();      Cache.Labels[p]=nil      end
    if Cache.Health[p]      then Cache.Health[p]:Destroy();      Cache.Health[p]=nil      end
    if Cache.Outlines[p]    then Cache.Outlines[p]:Destroy();    Cache.Outlines[p]=nil    end
    for _,key in ipairs({"Squares","TeamSquares","Skeletons","Cones"}) do
        if Cache[key][p] then
            for _,ln in pairs(Cache[key][p]) do pcall(function() ln:Remove() end) end
            Cache[key][p]=nil
        end
    end
    if PlayerCards[p] then PlayerCards[p]:Destroy(); PlayerCards[p]=nil end
end
Players.PlayerRemoving:Connect(ReleasePlayer)

