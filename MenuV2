-- 11. DECOUPLED DYNAMIC TARGET RESOLVER
-- ═══════════════════════════════════════════════════════════════
local function VerifyLock(t)
    if not t or not t.Parent then return false end
    local pt=GetAimPart(t,Vals.TPart); local hum=t:FindFirstChildOfClass("Humanoid")
    if not pt or not hum or hum.Health<=0 then return false end
    if (pt.Position-Cam.CFrame.Position).Magnitude>Vals.FOV*10 then return false end
    if FLAGS.AimbotWallCheck then
        RPar.FilterDescendantsInstances={LP.Character,Cam,t}
        if Workspace:Raycast(Cam.CFrame.Position,pt.Position-Cam.CFrame.Position,RPar) then return false end
    end
    return true
end

local function GetAimbotTarget(activelyLocking)
    if activelyLocking and LockedTarget and VerifyLock(LockedTarget) then
        return LockedTarget
    end
    
    if not activelyLocking then
        LockedTarget = nil
    end

    local best, bestD = nil, Vals.FOV
    local mp = UIS:GetMouseLocation()

    local function check(char)
        local pt = GetAimPart(char, Vals.TPart)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not pt or not hum or hum.Health <= 0 then return end
        
        local sp, on = Cam:WorldToViewportPoint(pt.Position)
        if not on then return end
        
        local d = (Vector2.new(sp.X, sp.Y) - mp).Magnitude
        if d >= bestD then return end
        
        if FLAGS.AimbotWallCheck then
            RPar.FilterDescendantsInstances = {LP.Character, Cam, char}
            if Workspace:Raycast(Cam.CFrame.Position, pt.Position - Cam.CFrame.Position, RPar) then return end
        end
        
        bestD = d
        best = char
    end

    if FLAGS.TarPlayers then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then check(p.Character) end
        end
    end
    if FLAGS.TarBosses then for b in pairs(Bosses) do if b and b.Parent then check(b) end end end
    if FLAGS.TarNPCs then
        for n in pairs(GenNPCs) do
            if n and n.Parent and not Players:GetPlayerFromCharacter(n) then check(n) end
        end
    end

    if activelyLocking then
        LockedTarget = best
    end
    return best
end

