local function CheckNPC(v)
    if not v:IsA("Model") or v==LP.Character then return end
    if v.Name:find("Whisper") or v.Name:find("Dozer") or v.Name:find("Anton") or v.Name:find("MI-24V") then
        Bosses[v]=true
    elseif v:FindFirstChildOfClass("Humanoid") and v:FindFirstChild("Head") and not Players:GetPlayerFromCharacter(v) then
        GenNPCs[v]=true
    end
end
for _,v in pairs(Workspace:GetDescendants()) do CheckNPC(v) end
Workspace.DescendantAdded:Connect(CheckNPC)
Workspace.DescendantRemoving:Connect(function(v) Bosses[v]=nil; GenNPCs[v]=nil end)

task.spawn(function()
    while task.wait(math.max(RATES.NPCTracker,0.25)) do
        pcall(UpdatePlayersTab)
        if not FLAGS.NPCTracker then continue end
        local lpHRP=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local lpPos=lpHRP and lpHRP.Position
        if not lpPos then continue end
        local active={}
        local function scan(t,pri)
            for v in pairs(t) do
                if v and v.Parent then
                    local hum=v:FindFirstChildOfClass("Humanoid")
                    local rp=v.PrimaryPart and v.PrimaryPart.Position or (pcall(function() return v:GetPivot().Position end) and v:GetPivot().Position)
                    if hum and hum.Health>0 and rp then
                        local d=(rp-lpPos).Magnitude
                        if d<=Vals.NPCDist then active[#active+1]={name=v.Name,hp=hum.Health,dist=d,pri=pri} end
                    end
                else t[v]=nil end
            end
        end
        scan(Bosses,1); scan(GenNPCs,2)
        table.sort(active,function(a,b) return a.pri~=b.pri and a.pri<b.pri or a.dist<b.dist end)
        local lines={}
        for _,e in ipairs(active) do
            local prefix=e.pri==1 and "★ " or ""
            lines[#lines+1]=prefix..e.name.." ["..math.floor(e.hp).."HP | "..math.floor(e.dist).."s]"
        end
        NPCList.Text=#lines>0 and table.concat(lines,"\n") or "No NPCs in Range"
    end
end)

local function HookNPC(model)
    if not model:IsA("Model") then return end
    
    -- 1. Ignore LocalPlayer character and any sub-rigs
    if model == LP.Character or model:IsDescendantOf(LP.Character) then return end
    
    -- 2. Ignore camera viewmodels (where FPS arms live)
    if model:IsDescendantOf(Cam) then return end
    
    -- 3. Ignore player characters
    if Players:GetPlayerFromCharacter(model) then return end
    if NPCCache[model] then return end

    -- 4. Reject common first-person viewmodel and weapon model names
    local lowName = model.Name:lower()
    if lowName:find("viewmodel") or lowName:find("arms") or lowName:find("weapon") or lowName:find("gun") then
        return
    end

    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local hl = Instance.new("Highlight")
    hl.Name = "NPC_YellowHL"
    hl.Adornee = model
    hl.FillColor = Color3.fromRGB(255, 220, 0)
    hl.FillTransparency = 0.5
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Enabled = FLAGS.NPCChams
    hl.Parent = model

    NPCCache[model] = hl

    model.AncestryChanged:Connect(function(_, parent)
        if not parent then
            if hl then hl:Destroy() end
            NPCCache[model] = nil
        end
    end)
end
for _, v in ipairs(Cam:GetDescendants()) do
    if v:IsA("Highlight") and v.Name == "NPC_YellowHL" then
        v:Destroy()
    end
end
if LP.Character then
    for _, v in ipairs(LP.Character:GetDescendants()) do
        if v:IsA("Highlight") and v.Name == "NPC_YellowHL" then
            v:Destroy()
        end
    end
end

for _, obj in ipairs(Workspace:GetDescendants()) do
    if obj:IsA("Model") and not Players:GetPlayerFromCharacter(obj) then
        if obj:FindFirstChildOfClass("Humanoid") then
            HookNPC(obj)
        end
    end
end
Workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("Humanoid") and obj.Parent and obj.Parent:IsA("Model") then
        task.wait(0.1)
        HookNPC(obj.Parent)
    end
end)

