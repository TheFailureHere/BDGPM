local function BindLabel(b) return b and b.Name or "None" end
local function BindDisplay(b)
    if not b then return "None" end
    local m={MouseButton1="LeftMouse",MouseButton2="RightMouse",MouseButton3="MiddleMouse"}
    return m[b.Name] or b.Name
end
local function InputKey(i) return i.KeyCode==Enum.KeyCode.Unknown and i.UserInputType or i.KeyCode end
local function KeyMatches(i,b) return b~=nil and InputKey(i)==b end

local function GetAimPart(model,part)
    if not model then return nil end
    if part=="Head"  then return model:FindFirstChild("Head") end
    if part=="Torso" then return model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso") or model:FindFirstChild("HumanoidRootPart") end
    return model:FindFirstChild(part) or model.PrimaryPart
end

local function IsBindHeld(bind)
    if not bind then return false end
    local ok,v = pcall(function()
        if bind.EnumType==Enum.KeyCode then return UIS:IsKeyDown(bind) end
        return UIS:IsMouseButtonPressed(bind)
    end)
    return ok and v==true
end

local function RateAllow(key,dt)
    local iv = RATES[key] or 0
    if iv<=0 then return true end
    RateTimers[key] = (RateTimers[key] or 0)+dt
    if RateTimers[key]>=iv then RateTimers[key]=0; return true end
    return false
end

-- Fix: Force all transparent Glass to SmoothPlastic so Highlights render through
local function FixGlassOcclusion(enabled)
    for _, part in ipairs(Workspace:GetDescendants()) do
        if part:IsA("BasePart") then
            if enabled then
                if part.Material == Enum.Material.Glass then
                    part:SetAttribute("WasGlass", true)
                    part.Material = Enum.Material.SmoothPlastic
                end
            else
                if part:GetAttribute("WasGlass") then
                    part.Material = Enum.Material.Glass
                    part:SetAttribute("WasGlass", nil)
                end
            end
        end
    end
end

-- Parallax & Sensitivity Calibrated Aim
local function ApplyAim(tPos, alpha)
    if Vals.AimMethod == "Camera" then
        local targetCF = CFrame.lookAt(Cam.CFrame.Position, tPos)
        Cam.CFrame = Cam.CFrame:Lerp(targetCF, alpha)
    elseif mousemoverel then
        local sp, on = Cam:WorldToViewportPoint(tPos)
        if on then
            local mp = UIS:GetMouseLocation()
            local sens = UserSettings():GetService("UserGameSettings").MouseSensitivity
            local dx = (sp.X - mp.X) / math.max(sens, 0.05)
            local dy = (sp.Y - mp.Y) / math.max(sens, 0.05)
            mousemoverel(dx * alpha * 0.25, dy * alpha * 0.25)
        end
    else
        local targetCF = CFrame.lookAt(Cam.CFrame.Position, tPos)
        Cam.CFrame = Cam.CFrame:Lerp(targetCF, alpha)
    end
end

