-- 5. NO-RECOIL
-- ═══════════════════════════════════════════════════════════════
local oldNRI
local function ApplyNoRecoil()
    if not FLAGS.NoRecoil then return end
    if Vals.NoRecoilMethod=="Method A" and getgc then
        local found=false
        for _,v in pairs(getgc(true)) do
            if type(v)=="table" then
                for k,val in pairs(v) do
                    if type(k)=="string" and type(val)=="number" and
                       (k:lower():find("recoil") or k:lower():find("sway") or k:lower():find("spread")) then
                        pcall(function() v[k]=0 end); found=true
                    end
                end
            end
        end
        if found then return end
        Vals.NoRecoilMethod="Method B"
    end
    local mt=getrawmetatable and getrawmetatable(Cam)
    if mt and setreadonly then
        setreadonly(mt,false)
        oldNRI=rawget(mt,"__newindex")
        rawset(mt,"__newindex",newcclosure(function(t,k,v)
            if t==Cam and k=="CFrame" and FLAGS.NoRecoil then
                v=CFrame.new(v.Position)*CFrame.Angles(select(1,Cam.CFrame:ToEulerAnglesXYZ()),select(2,Cam.CFrame:ToEulerAnglesXYZ()),0)
            end
            if oldNRI then return oldNRI(t,k,v)
            else rawset(t,k,v) end
        end))
        setreadonly(mt,true)
    end
end

