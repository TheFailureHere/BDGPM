local RowTrackers = {}

local function GetRow(tabName)
    local rt = RowTrackers[tabName]
    if not rt or rt.count >= 2 then
        local tab = Tabs[tabName].p
        local rw = Instance.new("Frame", tab)
        rw.Name = "Row"; rw.BackgroundTransparency = 1
        rw.Size = UDim2.new(1, 0, 0, 0); rw.AutomaticSize = Enum.AutomaticSize.Y
        local rl = Instance.new("UIListLayout", rw)
        rl.FillDirection = Enum.FillDirection.Horizontal
        rl.Padding = UDim.new(0, 8); rl.SortOrder = Enum.SortOrder.LayoutOrder
        RowTrackers[tabName] = {frame=rw, count=0}
        rt = RowTrackers[tabName]
    end
    rt.count = rt.count + 1
    return rt.frame
end

function AddTab(name)
    local btn = Instance.new("TextButton", Sidebar)
