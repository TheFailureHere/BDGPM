    return btn
end

function AddStr(p, n, vK, opts, cb)
    local btn = Instance.new("TextButton", p)
    btn.Size = UDim2.new(0.92,0,0,28); btn.BackgroundColor3 = Color3.fromRGB(22,22,22)
    btn.Text = n..": "..tostring(Vals[vK]); btn.TextColor3 = Color3.new(0.8,0.8,0.8)
    btn.Font = "Code"; btn.TextSize = 12; Instance.new("UICorner", btn)
    btn.MouseButton1Click:Connect(function()
        for i,v in ipairs(opts) do
            if v==Vals[vK] then
                Vals[vK] = opts[i+1] or opts[1]; btn.Text = n..": "..Vals[vK]
                if cb then cb(Vals[vK]) end; break
            end
        end
    end)
    table.insert(UIUpdaters, function() btn.Text=n..": "..tostring(Vals[vK]) end)
    return btn
end

function AddRGB(p, n, vK)
    local f = Instance.new("Frame", p)
    f.Size = UDim2.new(0.92,0,0,32); f.BackgroundTransparency = 1
    local lbl = Instance.new("TextLabel", f)
    lbl.Size = UDim2.new(0.38,0,1,0); lbl.Text = n; lbl.TextColor3 = Color3.new(1,1,1)
    lbl.BackgroundTransparency = 1; lbl.TextXAlignment = "Left"; lbl.Font = "Code"; lbl.TextSize = 11
    local tbs = {}
    local function ci(xOff, idx)
        local box = Instance.new("TextBox", f)
        box.Size = UDim2.new(0.18,0,0.8,0); box.Position = UDim2.new(xOff,0,0.1,0)
        box.BackgroundColor3 = Color3.fromRGB(16,16,16); box.Text = tostring(Vals[vK][idx])
        box.TextColor3 = Color3.new(1,1,1); box.Font = "Code"; box.TextSize = 11
        Instance.new("UICorner", box)
        box.FocusLost:Connect(function()
            Vals[vK][idx] = math.clamp(tonumber(box.Text) or Vals[vK][idx],0,255)
            box.Text = tostring(Vals[vK][idx])
            if vK=="Acc" then menuDirty=true; ApplyAccentColors() end
            if vK=="FlashCol" then Flash.BackgroundColor3=Color3.fromRGB(unpack(Vals.FlashCol)) end
        end)
        tbs[idx] = box
    end
    ci(0.40,1); ci(0.60,2); ci(0.80,3)
    table.insert(UIUpdaters, function() for i=1,3 do tbs[i].Text=tostring(Vals[vK][i]) end end)
    return f
end

