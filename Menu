local function UpdatePlayersTab()
    if not Tabs["Players"] then return end
    for p,card in pairs(PlayerCards) do
        if not Players:FindFirstChild(p.Name) then card:Destroy(); PlayerCards[p]=nil end
    end
    for _,p in ipairs(Players:GetPlayers()) do
        if not PlayerCards[p] then
