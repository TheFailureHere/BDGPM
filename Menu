local function UpdateCrosshair()
    if not HasDrawing then return end
    local cx,cy=Cam.ViewportSize.X/2,Cam.ViewportSize.Y/2
    local col=Color3.fromRGB(unpack(Vals.CHCol))
    local g,ln,th=Vals.CHGap,Vals.CHLen,Vals.CHThick
    local segs={
        {cx-g-ln,cy,cx-g,cy},{cx+g,cy,cx+g+ln,cy},
        {cx,cy-g-ln,cx,cy-g},{cx,cy+g,cx,cy+g+ln},
    }
    for i=1,4 do
        if not CrossLines[i] then CrossLines[i]=Drawing.new("Line"); CrossLines[i].Visible=false end
        local L=CrossLines[i]; local s=segs[i]
        if FLAGS.Crosshair then
            L.From=Vector2.new(s[1],s[2]); L.To=Vector2.new(s[3],s[4])
            L.Color=col; L.Thickness=th; L.Visible=true
        else L.Visible=false end
    end
end

