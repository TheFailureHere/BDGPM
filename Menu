    local tl = Instance.new("TextLabel", card)
    tl.Position = UDim2.new(0,10,0,10); tl.Size = UDim2.new(1,-55,0,22)
    tl.Text = name; tl.TextColor3 = Color3.new(1,1,1)
    tl.Font = "GothamBold"; tl.TextSize = 13; tl.BackgroundTransparency = 1; tl.TextXAlignment = "Left"

    local dl = Instance.new("TextLabel", card)
    dl.Position = UDim2.new(0,10,0,32); dl.Size = UDim2.new(1,-55,0,16)
    dl.Text = desc; dl.TextColor3 = Color3.new(0.4,0.4,0.4)
    dl.Font = "Gotham"; dl.TextSize = 9; dl.BackgroundTransparency = 1; dl.TextXAlignment = "Left"

    -- Click bounds strictly constrained to the top 65 pixels
    local expBtn = Instance.new("TextButton", card)
    expBtn.Size = UDim2.new(0.78,0,0,CARD_HEIGHT); expBtn.BackgroundTransparency = 1; expBtn.Text = ""; expBtn.ZIndex = 2

    local sub = Instance.new("Frame", card)
    sub.Name = "Sub"; sub.Position = UDim2.new(0,0,0,CARD_HEIGHT)
    sub.Size = UDim2.new(1,0,0,0); sub.BackgroundTransparency = 1
    local subLayout = Instance.new("UIListLayout", sub)
    subLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    subLayout.Padding = UDim.new(0,5)
    Instance.new("UIPadding", sub).PaddingTop = UDim.new(0,6)

    local expanded = false
    local function DoExpand()
        expanded = not expanded
        local subH = subLayout.AbsoluteContentSize.Y + 14
        local target = expanded and (CARD_HEIGHT + subH) or CARD_HEIGHT
        TweenSvc:Create(card, TweenInfo.new(0.25,Enum.EasingStyle.Quart), {Size=UDim2.new(0.5,-4,0,target)}):Play()
        -- Note: expBtn size is NOT resized, preventing accidental clicks closing the menu when clicking on sliders
    end
    expBtn.MouseButton1Click:Connect(DoExpand)

    local function UpdateUI()
        local on = FLAGS[flag]
        sw.BackgroundColor3 = on and Color3.fromRGB(unpack(Vals.Acc)) or Color3.fromRGB(30,30,30)
        TweenSvc:Create(dot,TweenInfo.new(0.18),{Position=on and UDim2.new(1,-15,0.5,-6) or UDim2.new(0,3,0.5,-6)}):Play()
        cs.Color = on and Color3.fromRGB(unpack(Vals.Acc)) or Color3.fromRGB(40,40,40)
        if flag=="NPCTracker" then NPCHUD.Visible=on end
        if flag=="StreamProof" then ApplyStreamProof() end
        if flag=="KeybindHUD"  then RefreshKeybindHUD() end
        if flag=="FullBright" and not on then
            Lighting.Ambient=OrigL.Amb; Lighting.OutdoorAmbient=OrigL.Out
            Lighting.Brightness=OrigL.Bri; Lighting.GlobalShadows=OrigL.Shad
        end
        if flag=="RemoveGrass" then
            pcall(function() Workspace.Terrain.Decoration = not on end)
        end
        if flag=="RenderPurge" then
            for _,v in pairs(Workspace:GetDescendants()) do
                if v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Sparkles") or v:IsA("Decal") then
                    pcall(function() v.Enabled = not on end)
                end
            end
        end
    end
    table.insert(UIUpdaters, UpdateUI)
    sw.MouseButton1Click:Connect(function()
        FLAGS[flag] = not FLAGS[flag]; UpdateUI()
        for _,fn in pairs(UIUpdaters) do pcall(fn) end
    end)
    UpdateUI()
    return sub
end

