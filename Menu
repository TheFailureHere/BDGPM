            local nl=Instance.new("TextLabel",card)
            nl.Size=UDim2.new(1,-10,0,18); nl.Position=UDim2.new(0,8,0,6)
            nl.Text=p.DisplayName.." [@"..p.Name.."]"; nl.TextColor3=Color3.new(1,1,1)
            nl.Font="GothamBold"; nl.TextSize=11; nl.BackgroundTransparency=1; nl.TextXAlignment="Left"
            local bg=Instance.new("Frame",card)
            bg.Size=UDim2.new(1,-16,0,6); bg.Position=UDim2.new(0,8,0,30)
            bg.BackgroundColor3=Color3.fromRGB(30,30,30); bg.BorderSizePixel=0; Instance.new("UICorner",bg)
            local bar=Instance.new("Frame",bg); bar.Name="Bar"
            bar.Size=UDim2.new(1,0,1,0); bar.BackgroundColor3=Color3.fromRGB(unpack(Vals.Acc))
            bar.BorderSizePixel=0; Instance.new("UICorner",bar)
            local ht=Instance.new("TextLabel",card); ht.Name="HPText"
            ht.Size=UDim2.new(1,-10,0,14); ht.Position=UDim2.new(0,8,0,42)
            ht.BackgroundTransparency=1; ht.Text="HP: ---"; ht.TextColor3=Color3.new(0.6,0.6,0.6)
            ht.Font="Code"; ht.TextSize=11; ht.TextXAlignment="Left"
            PlayerCards[p]=card
        end
        local card=PlayerCards[p]; if not card then continue end
        local char=p.Character; local hum=char and char:FindFirstChildOfClass("Humanoid")
        local bar=card:FindFirstChild("Bar",true); local ht=card:FindFirstChild("HPText")
        if hum and bar and ht then
            local pct=math.clamp(hum.Health/hum.MaxHealth,0,1)
            bar.Size=UDim2.new(pct,0,1,0)
            bar.BackgroundColor3=Color3.fromHSV(pct*0.35,1,1)
