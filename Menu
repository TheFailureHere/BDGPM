-- ═══════════════════════════════════════════════════════════════
local function CheckNPC(v)
    if not v:IsA("Model") or v==LP.Character then return end
    if v.Name:find("Whisper") or v.Name:find("Dozer") or v.Name:find("Anton") or v.Name:find("MI-24V") then
        Bosses[v]=true
    elseif v:FindFirstChildOfClass("Humanoid") and v:FindFirstChild("Head") and not Players:GetPlayerFromCharacter(v) then
        GenNPCs[v]=true
    end
end
for _,v in pairs(Workspace:GetDescendants()) do CheckNPC(v) end
Workspace.DescendantAdded:Connect(CheckNPC)
Workspace.DescendantRemoving:Connect(function(v) Bosses[v]=nil; GenNPCs[v]=nil end)

task.spawn(function()
    while task.wait(math.max(RATES.NPCTracker,0.25)) do
        pcall(UpdatePlayersTab)
        if not FLAGS.NPCTracker then continue end
        local lpHRP=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local lpPos=lpHRP and lpHRP.Position
        if not lpPos then continue end
        local active={}
        local function scan(t,pri)
            for v in pairs(t) do
                if v and v.Parent then
                    local hum=v:FindFirstChildOfClass("Humanoid")
                    local rp=v.PrimaryPart and v.PrimaryPart.Position or (pcall(function() return v:GetPivot().Position end) and v:GetPivot().Position)
                    if hum and hum.Health>0 and rp then
                        local d=(rp-lpPos).Magnitude
                        if d<=Vals.NPCDist then active[#active+1]={name=v.Name,hp=hum.Health,dist=d,pri=pri} end
                    end
                else t[v]=nil end
            end
        end
        scan(Bosses,1); scan(GenNPCs,2)
        table.sort(active,function(a,b) return a.pri~=b.pri and a.pri<b.pri or a.dist<b.dist end)
        local lines={}
        for _,e in ipairs(active) do
            local prefix=e.pri==1 and "★ " or ""
            lines[#lines+1]=prefix..e.name.." ["..math.floor(e.hp).."HP | "..math.floor(e.dist).."m]"
        end
        NPCList.Text=#lines>0 and table.concat(lines,"\n") or "No NPCs in Range"
    end
end)

