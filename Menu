-- 16. PHYSICS ENGINE
-- ═══════════════════════════════════════════════════════════════
RunService.Stepped:Connect(function(_,dt)
    lastPhys=lastPhys+dt
    if RATES.Physics>0 and lastPhys<RATES.Physics then return end
    lastPhys=0

    local char=LP.Character; if not char then return end
    local h=char:FindFirstChildOfClass("Humanoid")
    local hrp=char:FindFirstChild("HumanoidRootPart")

    if h then
        if FLAGS.Speed or FLAGS.AntiSlowdown then
            if not wasSpeed then origWS=h.WalkSpeed; wasSpeed=true end
            h.WalkSpeed=Vals.WS
        elseif wasSpeed then h.WalkSpeed=origWS; wasSpeed=false end
        if FLAGS.Jump then
            if not wasJump then origJP=h.JumpPower; wasJump=true end
            h.JumpPower=Vals.JP
        elseif wasJump then h.JumpPower=origJP; wasJump=false end
    end

    if FLAGS.Fly and hrp and h then
        local isAdmin=Vals.FlyLogic=="Admin"
        h.PlatformStand=isAdmin
        local fwd=(Vals.FlyLogic=="Camera" or isAdmin) and Cam.CFrame.LookVector or char:GetPivot().LookVector
        local rgt=(Vals.FlyLogic=="Camera" or isAdmin) and Cam.CFrame.RightVector or char:GetPivot().RightVector
        local dir=fwd*(UIS:IsKeyDown(Enum.KeyCode.W) and 1 or UIS:IsKeyDown(Enum.KeyCode.S) and -1 or 0)
                 +rgt*(UIS:IsKeyDown(Enum.KeyCode.D) and 1 or UIS:IsKeyDown(Enum.KeyCode.A) and -1 or 0)
        if isAdmin then
            hrp.Velocity=dir*Vals.FlyS
            if dir.Magnitude==0 then hrp.Velocity=Vector3.new(0,0.01,0) end
        else
            hrp.Velocity=dir*Vals.FlyS; hrp.Anchored=(dir.Magnitude==0)
        end
    elseif hrp and not FLAGS.Fly then
        hrp.Anchored=false; if h then h.PlatformStand=false end
    end

    if FLAGS.Noclip and char then
        for _,v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                local override=false
                for limb,m in pairs(LimbModes) do
                    if v.Name:find(limb) then
                        v.CanCollide=(m==1); override=true; break
                    end
                end
                if not override then v.CanCollide=false end
            end
        end
    end

    if FLAGS.FrictionMod and char then
        for _,v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                pcall(function() v.CustomPhysicalProperties=PhysicalProperties.new(0,0,0,100,100) end)
            end
        end
    end
end)

