    sw.Position = UDim2.new(1,-42,0,16); sw.Size = UDim2.new(0,32,0,18)
    sw.Text = ""; sw.BackgroundColor3 = Color3.fromRGB(30,30,30); sw.ZIndex = 2
    Instance.new("UICorner", sw).CornerRadius = UDim.new(1,0)
    local dot = Instance.new("Frame", sw)
