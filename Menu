local Screen
local function ApplyStreamProof()
    if not Screen then return end
    local parent=LP:WaitForChild("PlayerGui")
    if FLAGS.StreamProof then
        if gethui then parent=gethui()
        else parent=game:GetService("CoreGui") end
    end
    Screen.Parent=parent
    pcall(function() if protectgui then protectgui(Screen) end end)
end

local function SaveConfig(name)
    local sb={}; for k,v in pairs(BINDS) do sb[k]=BindLabel(v) end
    if writefile then writefile("BDGPM("..name..").json",Http:JSONEncode({F=FLAGS,B=sb,L=LimbModes,V=Vals,R=RATES})) end
end
local function LoadConfig(name)
    if not(readfile and isfile and isfile("BDGPM("..name..").json")) then return end
    local ok,data=pcall(function() return Http:JSONDecode(readfile("BDGPM("..name..").json")) end)
    if not ok or not data then return end
    for k,v in pairs(data.F or {}) do FLAGS[k]=v end
    for k,v in pairs(data.B or {}) do
        if v=="None" then BINDS[k]=nil
        else local s,e=pcall(function() return Enum.KeyCode[v] or Enum.UserInputType[v] end); if s and e then BINDS[k]=e end end
    end
    for k,v in pairs(data.L or {}) do LimbModes[k]=v end
    for k,v in pairs(data.V or {}) do Vals[k]=v end
    for k,v in pairs(data.R or {}) do RATES[k]=v end
    if (Vals.BGTrans or 0)>1 then Vals.BGTrans=Vals.BGTrans/100 end
    menuDirty=true; ApplyMenuTheme(); ApplyAccentColors(); ApplyStreamProof(); RefreshKeybindHUD()
end

