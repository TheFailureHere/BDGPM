function AddSli(p, n, vK, mn, mx)
    local box = Instance.new("TextBox", p)
    box.Size = UDim2.new(0.92,0,0,28); box.BackgroundColor3 = Color3.fromRGB(16,16,16)
    box.Text = n..": "..tostring(Vals[vK]); box.TextColor3 = Color3.new(0.8,0.8,0.8)
    box.Font = "Code"; box.TextSize = 12; Instance.new("UICorner", box)
    box.FocusLost:Connect(function()
        local v = tonumber(box.Text:match("%d+%.?%d*"))
        if v then Vals[vK]=math.clamp(v,mn,mx) end
        box.Text = n..": "..tostring(Vals[vK])
    end)
    table.insert(UIUpdaters, function() box.Text=n..": "..tostring(Vals[vK]) end)
    return box
end

