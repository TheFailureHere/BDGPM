function AddBind(p, n, bK)
    local btn = Instance.new("TextButton", p)
    btn.Size = UDim2.new(0.92,0,0,28); btn.BackgroundColor3 = Color3.fromRGB(22,22,22)
    btn.Text = n..": "..BindDisplay(BINDS[bK]); btn.TextColor3 = Color3.new(0.7,0.7,0.7)
    btn.Font = "Code"; btn.TextSize = 12; Instance.new("UICorner", btn)
    btn.MouseButton1Click:Connect(function()
        btn.Text = "Press key..."
        local c; c = UIS.InputBegan:Connect(function(i,gp)
            if gp then return end
            if i.KeyCode==Enum.KeyCode.Escape or i.KeyCode==Enum.KeyCode.Backspace then
                BINDS[bK]=nil; btn.Text=n..": None"; c:Disconnect(); RefreshKeybindHUD(); return
            end
            local key = (i.UserInputType==Enum.UserInputType.Keyboard and i.KeyCode or i.UserInputType)
            BINDS[bK]=key; btn.Text=n..": "..BindDisplay(key); c:Disconnect(); RefreshKeybindHUD()
        end)
    end)
    table.insert(UIUpdaters, function() btn.Text=n..": "..BindDisplay(BINDS[bK]) end)
    return btn
end

function AddTog(p, n, f)
    local btn = Instance.new("TextButton", p)
