-- 15. RENDER ENGINE
-- ═══════════════════════════════════════════════════════════════
RunService.RenderStepped:Connect(function(dt)

    -- FullBright
    if FLAGS.FullBright then
        Lighting.Ambient=Color3.new(1,1,1); Lighting.OutdoorAmbient=Color3.new(1,1,1)
        Lighting.Brightness=2; Lighting.GlobalShadows=false
    end

    -- Zoom
    if FLAGS.Zoom~=LastZoomState then
        LastZoomState=FLAGS.Zoom
        if FLAGS.Zoom then OrigCamFOV=Cam.FieldOfView; Cam.FieldOfView=Vals.ZoomFOV
        else Cam.FieldOfView=OrigCamFOV end
    elseif FLAGS.Zoom then Cam.FieldOfView=Vals.ZoomFOV end

    local inset=GuiService:GetGuiInset()
    local mPos=UIS:GetMouseLocation()-inset

    -- FOV circle
    if FOVCircle then
        FOVCircle.Visible=FLAGS.Aimbot
        if FLAGS.Aimbot then
            FOVCircle.Position=UIS:GetMouseLocation()
            FOVCircle.Radius=Vals.FOV; FOVCircle.Color=Color3.fromRGB(unpack(Vals.FOVCol))
        end
    end

-- Triggerbot
    if FLAGS.Triggerbot and (Vals.TriggerbotLogic=="Toggle" or TriggerHold) then
        if not triggerDebounce then
            -- Adaptive Ray: Handles both locked FPS crosshairs and free cursor modes
            local uRay
            if UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then
                -- Pure camera center boresight: 0% chance of mouse desync or stale coordinates
                uRay = Ray.new(Cam.CFrame.Position, Cam.CFrame.LookVector)
            else
                -- Free cursor mode: Screen space adjusted precisely for GUI inset
                local inset = GuiService:GetGuiInset()
                local mp = UIS:GetMouseLocation() - inset
                uRay = Cam:ViewportPointToRay(mp.X, mp.Y)
            end

            RPar.FilterDescendantsInstances = {LP.Character, Cam}
            local hit = Workspace:Raycast(uRay.Origin, uRay.Direction * 1000, RPar)
            if hit and hit.Instance then
                local model = hit.Instance:FindFirstAncestorOfClass("Model")
                local hum = model and model:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local isPlayer = Players:GetPlayerFromCharacter(model) ~= nil
                    if isPlayer or FLAGS.TriggerbotNPCs then
                        triggerDebounce = true
                        
                        local function FireAction()
                            local tool = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
                            if tool then
                                tool:Activate()
                            elseif mouse1press and mouse1release then
                                mouse1press()
                                task.wait(math.max(Vals.TriggerHold / 1000, 0.005))
                                mouse1release()
                            elseif mouse1click then
                                mouse1click()
                            end

                            if Vals.TriggerReset > 0 then
                                task.wait(Vals.TriggerReset / 1000)
                            end
                            triggerDebounce = false
                        end

                        if Vals.TriggerDelay > 0 then
                            task.spawn(function()
                                task.wait(Vals.TriggerDelay / 1000)
                                FireAction()
                            end)
                        else
                            task.spawn(FireAction)
                        end
                    end
                end
            end
        end
    end

    -- Aimbot Target Updating & Display Info
    if RateAllow("Aimbot",dt) then
        if FLAGS.Aimbot then
            local target=GetAimbotTarget()
            local pt=target and GetAimPart(target,Vals.TPart)
            Locking = AimLockActive()
            
            if Locking and pt then
                if FLAGS.TargetInfo then
                    local ml=UIS:GetMouseLocation()
                    TargetUI.Visible=true
                    TargetUI.Position=UDim2.fromOffset(ml.X+20,ml.Y+20)
                    local hum=target:FindFirstChildOfClass("Humanoid")
                    TargetUI.Text="TARGET: "..target.Name.."\nPART: "..pt.Name.."\nHP: "..(hum and math.floor(hum.Health) or 0)
                else
                    TargetUI.Visible=false
                end
                
                local tPos=pt.Position
                local root=target.PrimaryPart or target:FindFirstChild("HumanoidRootPart")
                if FLAGS.Prediction and root then tPos=tPos+(root.AssemblyLinearVelocity*Vals.PredP) end
                local alpha=Vals.Smooth==0 and 1 or math.clamp(Vals.Pull/(Vals.Smooth*5),0.05,1)
                ApplyAim(tPos,alpha)
            else
                Locking=false
                TargetUI.Visible=false
            end
        else
            Locking=false
            TargetUI.Visible=false
            LockedTarget=nil
        end
    end

    -- Crosshair
    if RateAllow("Crosshair",dt) then UpdateCrosshair() end

    -- Spidey
    local ft=false
    if FLAGS.Spidey and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        local hrp=LP.Character.HumanoidRootPart
        for _,p in pairs(Players:GetPlayers()) do
            if p~=LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                if (p.Character.HumanoidRootPart.Position-hrp.Position).Magnitude<=Vals.DetR then ft=true; break end
            end
        end
    end
    Flash.BackgroundTransparency=ft and (1-(math.abs(math.sin(time()*Vals.FlashF))*Vals.FlashI)) or 1

    -- Indicator
    if RateAllow("Indicator",dt) then
        for _,p in pairs(Players:GetPlayers()) do
            if p==LP then continue end
            local char=p.Character
            local hrp=char and char:FindFirstChild("HumanoidRootPart")
            local hum=char and char:FindFirstChildOfClass("Humanoid")
            local alive=hrp and hum and hum.Health>0
            local dist=alive and (hrp.Position-Cam.CFrame.Position).Magnitude or math.huge
            local ind=Cache.Indicators[p]
            if FLAGS.Indicator and alive and dist<Vals.IndRange then
                if not ind then
                    ind=Instance.new("Frame",Screen); ind.Size=UDim2.fromOffset(Vals.IndSize,4)
                    Instance.new("UICorner",ind)
                    local lbl=Instance.new("TextLabel",ind); lbl.Name="IL"
                    lbl.Size=UDim2.new(0,110,0,14); lbl.Position=UDim2.new(0.5,-55,1,3)
                    lbl.BackgroundTransparency=1; lbl.TextColor3=Color3.new(1,1,1)
                    lbl.Font="Code"; lbl.TextSize=10; lbl.TextStrokeTransparency=0.4
                    Cache.Indicators[p]=ind
                end
                ind.Size=UDim2.fromOffset(Vals.IndSize,4)
                ind.BackgroundColor3=Color3.fromRGB(unpack(Vals.IndCol)); ind.Visible=true
                local il=ind:FindFirstChild("IL")
                if Vals.IndicatorMinimap=="Minimap" then
                    local cf=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and LP.Character.HumanoidRootPart.CFrame
                    if cf then
                        local toT=(hrp.Position-cf.Position)*Vector3.new(1,0,1)
                        local ang=math.atan2(toT:Dot(cf.RightVector*Vector3.new(1,0,1)),toT:Dot(cf.LookVector*Vector3.new(1,0,1)))
                        local cx2,cy2=Cam.ViewportSize.X/2,Cam.ViewportSize.Y/2
                        ind.Position=UDim2.fromOffset(cx2+math.sin(ang)*Vals.IndOffset-(Vals.IndSize/2),cy2-math.cos(ang)*Vals.IndOffset-2)
                        ind.Rotation=math.deg(ang)
                    end
                else
                    local sp,_=Cam:WorldToViewportPoint(hrp.Position)
                    local ang=math.atan2(sp.Y-mPos.Y,sp.X-mPos.X)
                    ind.Rotation=math.deg(ang)
                    ind.Position=UDim2.fromOffset(mPos.X+math.cos(ang)*Vals.IndOffset-(Vals.IndSize/2),mPos.Y+math.sin(ang)*Vals.IndOffset)
                end
                if il then il.TextSize=math.clamp(8*(1-dist/Vals.IndRange),6,8); il.Text=p.DisplayName.."["..math.floor(dist).."m]" end
            elseif ind then ind.Visible=false end
        end
    end

    -- ESP
    if RateAllow("ESP",dt) then
        for _,p in pairs(Players:GetPlayers()) do
            if p==LP then continue end
            local char=p.Character
            local hrp=char and char:FindFirstChild("HumanoidRootPart")
            local head=char and char:FindFirstChild("Head")
            local hum=char and char:FindFirstChildOfClass("Humanoid")
            local alive=hrp and head and hum and hum.Health>0
            local dist=alive and (hrp.Position-Cam.CFrame.Position).Magnitude or math.huge
            local labelInRange=dist<Vals.LabelDist
            local boxInRange=dist<Vals.BoxDist
            local skelInRange=dist<Vals.SkeletonDist

            local isVis=true
            if alive and (FLAGS.LabelVisCheck or FLAGS.PeekingLogic) then
                RPar.FilterDescendantsInstances={LP.Character,char}
                if Workspace:Raycast(Cam.CFrame.Position,head.Position-Cam.CFrame.Position,RPar) then isVis=false end
            end

            -- Stream-safe Billboard Labels
            local lbl=Cache.Labels[p]
            if FLAGS.Labels and alive and labelInRange then
                if not lbl or lbl.Adornee~=head then
                    if lbl then lbl:Destroy() end
                    lbl=Instance.new("BillboardGui",Screen); lbl.Name="BDGPM_Lbl"
                    lbl.Adornee=head; lbl.AlwaysOnTop=true; lbl.Size=UDim2.new(0,130,0,24); lbl.StudsOffset=Vector3.new(0,2.4,0)
                    local txt=Instance.new("TextLabel",lbl); txt.Name="T"; txt.Size=UDim2.new(1,0,1,0)
                    txt.BackgroundTransparency=1; txt.Font="Code"; txt.TextStrokeTransparency=0.4
                    Cache.Labels[p]=lbl
                end
                lbl.Enabled=true
                local txt=lbl:FindFirstChild("T")
                if txt then
                    txt.TextSize=Vals.TSize
                    txt.Text=(FLAGS.Usernames and p.Name or p.DisplayName).." ["..math.floor(dist).."m]"
                    txt.TextColor3=(FLAGS.LabelVisCheck and not isVis) and Color3.fromRGB(unpack(Vals.HidCol)) or Color3.fromRGB(unpack(Vals.VisCol))
                end
            elseif lbl then lbl.Enabled=false end

            -- Team Squares
            if HasDrawing then
                if FLAGS.TeamSquares and alive and labelInRange then
                    local proj,on=Cam:WorldToViewportPoint(head.Position+Vector3.new(0,1.2,0))
                    if on then
                        local tc=p.TeamColor and p.TeamColor.Color or Color3.new(1,1,1)
                        local sz,th=Vals.TeamSqSize,Vals.TeamSqThick
                        local x,y=proj.X-sz/2,proj.Y-sz/2
                        local segs={{x,y,x+sz,y},{x,y,x,y+sz},{x+sz,y,x+sz,y+sz},{x,y+sz,x+sz,y+sz}}
                        for i=1,4 do
                            local ln=DLine(Cache.TeamSquares,p,i); local s=segs[i]
                            ln.From=Vector2.new(s[1],s[2]); ln.To=Vector2.new(s[3],s[4])
                            ln.Color=tc; ln.Thickness=th; ln.Visible=true
                        end
                    else for i=1,4 do local ln=DLine(Cache.TeamSquares,p,i); ln.Visible=false end end
                else for i=1,4 do if Cache.TeamSquares[p] and Cache.TeamSquares[p][i] then Cache.TeamSquares[p][i].Visible=false end end end
            end

            -- ESP Boxes
            if HasDrawing then
                if FLAGS.ESPBoxes and alive and boxInRange then
                    local bx,by,bw,bh=GetProjectedBounds(char)
                    if bx then
                        local bc=Color3.fromRGB(unpack(Vals.BoxCol))
                        if Vals.BoxStyle=="Corners" then SetCornerBox(p,bx,by,bw,bh,bc,Vals.BoxCornerThick)
                        else SetFullBox(p,bx,by,bw,bh,bc,Vals.BoxThick) end
                    else HideBox(p) end
                else HideBox(p) end
            end

            -- Health Bars
            local hbg=Cache.Health[p]
            if FLAGS.HealthBars and alive and labelInRange then
                if not hbg or hbg.Parent~=head then
                    if hbg then hbg:Destroy() end
                    hbg=Instance.new("BillboardGui",head); hbg.Name="BDGPM_HP"
                    hbg.AlwaysOnTop=true; hbg.Size=UDim2.new(0,80,0,40)
                    hbg.StudsOffset=Vector3.new(Vals.HBO,0,0)
                    local bg2=Instance.new("Frame",hbg); bg2.Name="BG"
                    bg2.Size=UDim2.new(0,math.max(Vals.HBW,3),1,0)
                    bg2.BackgroundColor3=Color3.new(0,0,0); bg2.BorderSizePixel=0; Instance.new("UICorner",bg2)
                    local bar=Instance.new("Frame",bg2); bar.Name="Bar"
                    bar.AnchorPoint=Vector2.new(0,1); bar.Position=UDim2.new(0,0,1,0)
                    bar.Size=UDim2.new(1,0,1,0); bar.BorderSizePixel=0; Instance.new("UICorner",bar)
                    local txt=Instance.new("TextLabel",bg2); txt.Name="Txt"
                    txt.BackgroundTransparency=1; txt.ZIndex=15
                    txt.Position=UDim2.new(1,4,0.5,0); txt.AnchorPoint=Vector2.new(0,0.5)
                    txt.Size=UDim2.new(0,60,0,14); txt.Font="Code"; txt.TextSize=11
                    txt.TextColor3=Color3.new(1,1,1); txt.TextStrokeTransparency=0; txt.TextXAlignment="Left"
                    Cache.Health[p]=hbg
                end
                hbg.Enabled=true
                hbg.StudsOffset=Vector3.new(Vals.HBO,0,0)
                local bg2=hbg:FindFirstChild("BG")
                if bg2 then bg2.Size=UDim2.new(0,math.max(Vals.HBW,3),1,0) end
                local pct=math.clamp(hum.Health/hum.MaxHealth,0,1)
                local bar=bg2 and bg2:FindFirstChild("Bar")
                local txt=bg2 and bg2:FindFirstChild("Txt")
                if bar then
                    bar.Size=UDim2.new(1,0,pct,0)
                    bar.BackgroundColor3=FLAGS.DynamicColor and (
                        pct>=0.75 and Color3.new(0,1,0) or pct>=0.5 and Color3.new(1,1,0) or
                        pct>=0.25 and Color3.new(1,0.4,0) or Color3.fromRGB(150,0,0)
                    ) or Color3.fromRGB(unpack(Vals.Acc))
                end
                if txt then txt.Visible=FLAGS.HealthNumbers; txt.Text=math.floor(hum.Health).."/"..math.floor(hum.MaxHealth) end
            elseif hbg then hbg.Enabled=false end

            -- Skeleton ESP
            if HasDrawing then
                if FLAGS.SkeletonESP and alive and skelInRange then
                    local isR15=char:FindFirstChild("UpperTorso")~=nil
                    local pairs_list
                    if isR15 then
                        pairs_list={
                            {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
                            {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
                            {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
                            {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
                            {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
                        }
                    else
                        pairs_list={
                            {"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},
                            {"Torso","Left Leg"},{"Torso","Right Leg"},
                        }
                    end
                    local valid={}
                    for _,bp in ipairs(pairs_list) do
                        local j1=char:FindFirstChild(bp[1]); local j2=char:FindFirstChild(bp[2])
                        if j1 and j2 then valid[#valid+1]={j1.Position,j2.Position} end
                    end
                    local slines=GetSkeletonLines(p,#valid)
                    local col=Color3.fromRGB(unpack(Vals.SkeletonCol))
                    for i,bone in ipairs(valid) do
                        local p1,o1=Cam:WorldToViewportPoint(bone[1])
                        local p2,o2=Cam:WorldToViewportPoint(bone[2])
                        local ln=slines[i]
                        if o1 and o2 then
                            ln.From=Vector2.new(p1.X,p1.Y); ln.To=Vector2.new(p2.X,p2.Y)
                            ln.Color=col; ln.Thickness=Vals.SkeletonThick; ln.Visible=true
                        else ln.Visible=false end
                    end
                    for i=#valid+1,#slines do slines[i].Visible=false end
                else
                    local sl=Cache.Skeletons[p]; if sl then for _,ln in ipairs(sl) do ln.Visible=false end end
                end
            end

            -- Outlines (Chams)
            local hl=Cache.Outlines[p]
            if FLAGS.Outlines and alive and labelInRange then
                if not hl or hl.Parent~=char then if hl then hl:Destroy() end; hl=Instance.new("Highlight",char); Cache.Outlines[p]=hl end
                hl.Enabled=true; hl.FillTransparency=Vals.FillT; hl.OutlineTransparency=Vals.OutT
                hl.OutlineColor=Color3.fromRGB(unpack(Vals.OutCol))
                hl.FillColor=(FLAGS.PeekingLogic and not isVis) and Color3.fromRGB(unpack(Vals.HidCol)) or Color3.fromRGB(unpack(Vals.VisCol))
                hl.DepthMode = (Vals.ChamsDepth == "Always On Top") and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
            elseif hl then hl.Enabled=false end

            -- Beams
            local bm=Cache.Beams[p]
            if FLAGS.Beams and alive and labelInRange and HasDrawing then
                if not bm then pcall(function() bm=Drawing.new("Line"); Cache.Beams[p]=bm end) end
                if bm then
                    local sp,on=Cam:WorldToViewportPoint(hrp.Position)
                    if on then bm.Visible=true; bm.From=Vector2.new(Cam.ViewportSize.X/2,Cam.ViewportSize.Y)
                        bm.To=Vector2.new(sp.X,sp.Y); bm.Color=Color3.fromRGB(unpack(Vals.BeamCol))
                        bm.Thickness=Vals.BeamW; bm.Transparency=1-Vals.BeamT
                    else bm.Visible=false end
                end
            elseif bm then bm.Visible=false end
        end
    end -- ESP RateAllow
end) -- RenderStepped

